# Copy this file to .env for local development, and set these same
# values directly in Render's dashboard for production — never commit
# real secrets into this file or into git.

# Gmail address that sends the notification (tgrnho37@gmail.com)
GMAIL_USER=

# Gmail App Password — generate at myaccount.google.com/apppasswords
# after enabling 2-Step Verification. NEVER paste this into chat, code,
# or a committed file. Set it directly in Render's environment variables.
GMAIL_APP_PASSWORD=

# Where notification emails are sent. Defaults to GMAIL_USER if unset.
NOTIFY_TO=tgrnho37@gmail.com

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://sitespark.com,https://www.sitespark.com
ALLOWED_ORIGIN=http://localhost:3000

# Turso database connection. Create a free database at turso.tech, then
# get these two values from its dashboard (or `turso db show` / `turso db
# tokens create` via their CLI). Set both directly in Render's environment
# variables — never commit real values here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port the server listens on. Render sets this automatically — usually
# no need to set it yourself in production.
PORT=4000
